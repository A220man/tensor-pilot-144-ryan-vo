# TensorPilot Environment Configuration

# Application
APP_NAME=TensorPilot
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development
DEMO_MODE=true

# Server
HOST=127.0.0.1
PORT=8000

# Database (SQLite for development)
DATABASE_URL=sqlite+aiosqlite:///./tensorpilot.db
DATABASE_ECHO=false

# Security
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# OIDC / Keycloak (disabled in demo mode)
OIDC_ENABLED=true
OIDC_ISSUER_URL=http://localhost:8080/realms/tensorpilot
OIDC_CLIENT_ID=tensorpilot-backend
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=tensorpilot-api
OIDC_JWKS_URI=http://localhost:8080/realms/tensorpilot/protocol/openid-connect/certs

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# LLM / VoxCPM2
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=voxcpm2
LLM_BASE_URL=
VOXCPM_MODEL_PATH=
VOXCPM_DEVICE=cpu

# Redis
REDIS_URL=

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console